<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DokuVaultScanner</AssemblyName>
    <RootNamespace>DokuVault.Scanner</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>DokuVault Scanner</Product>
    <Company>DokuVault</Company>
    <Description>Scannt das Netzwerk und übernimmt IoT-Geräte und Drucker in DokuVault.</Description>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-hell.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DokuVault.Scanner.Core\DokuVault.Scanner.Core.csproj" />
  </ItemGroup>

</Project>
