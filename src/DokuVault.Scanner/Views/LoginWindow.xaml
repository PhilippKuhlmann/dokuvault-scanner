<Window x:Class="DokuVault.Scanner.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DokuVault.Scanner.Infrastructure"
        Title="DokuVault Scanner – Anmelden"
        Style="{StaticResource AppWindow}"
        Icon="pack://application:,,,/DokuVaultScanner;component/Assets/app.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource CardBorder}" Margin="20" Padding="28,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="{DynamicResource Logo}" Width="36" Height="36" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DokuVault Scanner" Style="{StaticResource H1}" />
                    <TextBlock Text="Netzwerk scannen, Geräte dokumentieren" Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource DangerLight}" CornerRadius="3" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
            </Border>

            <!-- Step 1: server and account -->
            <StackPanel Visibility="{Binding NeedsCredentials, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Server" Style="{StaticResource Label}" />
                <TextBox x:Name="ServerBox" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                         ToolTip="Die Adresse, unter der DokuVault im Browser läuft, z. B. dokuvault.firma.de" />
                <TextBlock Text="Benutzername" Style="{StaticResource Label}" />
                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                <TextBlock Text="Kennwort" Style="{StaticResource Label}" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,20" KeyDown="OnPasswordKeyDown" />
                <Button Content="Anmelden" Style="{StaticResource Primary}" Click="OnSignIn"
                        IsEnabled="{Binding IsBusy, Converter={x:Static local:Inverse.Instance}}" />
            </StackPanel>

            <!-- Step 2: second factor -->
            <StackPanel Visibility="{Binding NeedsCode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ihr Zugang ist mit einer zweiten Stufe geschützt. Bitte den sechsstelligen Code aus der Authenticator-App eingeben – oder einen Wiederherstellungscode."
                           TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Code" Style="{StaticResource Label}" />
                <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontSize="18"
                         Margin="0,0,0,20" KeyDown="OnCodeKeyDown" />
                <Grid>
                    <Button Content="Zurück" HorizontalAlignment="Left" Click="OnBack" />
                    <Button Content="Bestätigen" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="OnConfirm"
                            IsEnabled="{Binding IsBusy, Converter={x:Static local:Inverse.Instance}}" />
                </Grid>
            </StackPanel>

            <TextBlock Text="Das Kennwort wird nicht gespeichert – nur ein Token, verschlüsselt für Ihr Windows-Konto. Es gilt 30 Tage."
                       Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
        </StackPanel>
    </Border>
</Window>
