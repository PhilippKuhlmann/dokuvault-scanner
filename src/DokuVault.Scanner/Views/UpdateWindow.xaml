<Window x:Class="DokuVault.Scanner.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DokuVault Scanner – Update"
        Style="{StaticResource AppWindow}"
        Icon="pack://application:,,,/DokuVaultScanner;component/Assets/app.ico"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource CardBorder}" Margin="20" Padding="28,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="{DynamicResource Logo}" Width="36" Height="36" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DokuVault Scanner" Style="{StaticResource H1}" />
                    <TextBlock x:Name="Versions" Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="1" />
            <Button x:Name="Action" Content="Überspringen" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnAction" />
        </StackPanel>
    </Border>
</Window>
