<Window x:Class="DokuVault.Scanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:DokuVault.Scanner.Infrastructure"
        Title="DokuVault Scanner"
        Style="{StaticResource AppWindow}"
        Icon="pack://application:,,,/DokuVaultScanner;component/Assets/app.ico"
        Width="1480" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{x:Static inf:ThemeCommands.Toggle}" />
    </Window.InputBindings>
    <Window.Resources>
        <inf:FieldTemplateSelector x:Key="FieldEditor">
            <inf:FieldTemplateSelector.Text>
                <DataTemplate>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </inf:FieldTemplateSelector.Text>
            <inf:FieldTemplateSelector.Multiline>
                <DataTemplate>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" />
                </DataTemplate>
            </inf:FieldTemplateSelector.Multiline>
            <inf:FieldTemplateSelector.Choice>
                <DataTemplate>
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Option}" DisplayMemberPath="Label" />
                </DataTemplate>
            </inf:FieldTemplateSelector.Choice>
            <inf:FieldTemplateSelector.Bool>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Flag}" Content="ja" />
                </DataTemplate>
            </inf:FieldTemplateSelector.Bool>
            <inf:FieldTemplateSelector.Date>
                <DataTemplate>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="TT.MM.JJJJ" />
                </DataTemplate>
            </inf:FieldTemplateSelector.Date>
        </inf:FieldTemplateSelector>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MutedCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="{DynamicResource Logo}" Width="30" Height="30" />
                    <TextBlock Text="DokuVault" Style="{StaticResource H1}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="Scanner" FontSize="20" Foreground="{DynamicResource AccentText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UserText}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Command="{x:Static inf:ThemeCommands.Cycle}" Margin="0,0,8,0" />
                    <Button Content="Abmelden" Click="OnSignOut" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Kunde" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name"
                              Width="280" IsEnabled="{Binding IsBusy, Converter={x:Static inf:Inverse.Instance}}" />
                    <Button Content="↻" Margin="6,0,0,0" Padding="9,5" Command="{Binding RefreshDocumentedCommand}"
                            ToolTip="Dokumentierte Adressen neu laden" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scan bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="16,14,16,0" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Netzwerk dieses Rechners" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding LocalNetworkChoices}" SelectedItem="{Binding LocalNetwork}" Width="330"
                              IsEnabled="{Binding IsScanning, Converter={x:Static inf:Inverse.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Bereich" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" Width="210"
                             ToolTip="CIDR (192.168.1.0/24), Spanne (192.168.1.10-192.168.1.80 oder 192.168.1.10-80) oder eine Adresse"
                             IsEnabled="{Binding IsScanning, Converter={x:Static inf:Inverse.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="SNMP-Community" Style="{StaticResource Label}" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding UseSnmp}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  ToolTip="Drucker verraten per SNMP Modell und Seriennummer" />
                        <TextBox Text="{Binding SnmpCommunity}" Width="110" IsEnabled="{Binding UseSnmp}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Herstellerliste" Style="{StaticResource Link}" Command="{Binding UpdateVendorsCommand}"
                            VerticalAlignment="Center" Margin="0,0,16,0"
                            ToolTip="Die Herstellerliste der MAC-Adressen (IEEE) neu laden" />
                    <Button Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Netzwerk scannen" Style="{StaticResource Primary}" Command="{Binding ScanCommand}" MinWidth="130" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,10,0,0"
                      Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Height="4" Minimum="0" Maximum="{Binding ProgressTotal, Mode=OneWay}" Value="{Binding ProgressDone, Mode=OneWay}"
                                 BorderThickness="0" />
                </Grid>
            </Grid>
        </Border>

        <!-- Warnings -->
        <Border Grid.Row="2" Background="{DynamicResource WarnLight}" BorderBrush="{DynamicResource WarnBorder}" BorderThickness="1" CornerRadius="4"
                Margin="16,10,16,0" Padding="12,8" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" />
        </Border>

        <!-- List and detail -->
        <Grid Grid.Row="3" Margin="16,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,10" LastChildFill="False">
                        <TextBox DockPanel.Dock="Left" Width="220" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nach Adresse, Name, Hersteller, MAC … filtern" x:Name="FilterBox" />
                        <TextBlock DockPanel.Dock="Left" Text="Filter …" Foreground="{DynamicResource Placeholder}" IsHitTestVisible="False"
                                   Margin="-212,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding Filter, Converter={x:Static inf:VisibleWhenEmpty.Instance}}" />
                        <CheckBox DockPanel.Dock="Left" Content="Dokumentierte ausblenden" IsChecked="{Binding HideDocumented}"
                                  VerticalAlignment="Center" Margin="16,0,0,0" />
                        <CheckBox DockPanel.Dock="Left" Content="Nur mit Gerätetyp" IsChecked="{Binding OnlyCandidates}"
                                  VerticalAlignment="Center" Margin="16,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Keine" Style="{StaticResource Link}" Command="{Binding CheckNoneCommand}"
                                VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Text=" · " Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Alle mit Typ wählen" Style="{StaticResource Link}"
                                Command="{Binding CheckAllCommand}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" />

                    <Grid>
                        <DataGrid x:Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding Selected}"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" CanUserResizeRows="False"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding CanEdit}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="StatusText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource StatusPill}" Padding="7,2" HorizontalAlignment="Left"
                                                    ToolTip="{Binding ImportMessage}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="IP-Adresse" Width="118" MinWidth="118" SortMemberPath="SortKey">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Cell}" FontFamily="Consolas" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="130" SortMemberPath="DisplayName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Cell}" ToolTip="{Binding Hostname}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Hersteller" Width="*" MinWidth="80" SortMemberPath="Vendor">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Vendor}" Style="{StaticResource Cell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Modell" Width="1.3*" MinWidth="100" SortMemberPath="Model">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Model}" Style="{StaticResource Cell}" ToolTip="{Binding Model}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MAC" Width="150" MinWidth="150" SortMemberPath="Mac">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mac}" Style="{StaticResource MutedCell}" FontFamily="Consolas" FontSize="12" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Erkannt als" Width="110" SortMemberPath="SuggestionText">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource MutedCell}" ToolTip="{Binding Reasons}">
                                                <Run Text="{Binding SuggestionText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Übernehmen als" Width="160" SortMemberPath="Target.Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.TargetTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" Padding="5,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Dienste / Ports" Width="*" MinWidth="80" SortMemberPath="Services">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Services}" Style="{StaticResource MutedCell}" FontSize="12" ToolTip="{Binding Services}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding Rows.Count, Converter={x:Static inf:VisibleWhenEmpty.Instance}}">
                            <TextBlock Text="Noch keine Geräte" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                            <TextBlock Text="Bereich prüfen und „Netzwerk scannen“ wählen." Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Detail -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <TextBlock Text="Ein Gerät in der Liste wählen, um es vor dem Übernehmen zu prüfen."
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="30"
                               VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={x:Static inf:VisibleWhenEmpty.Instance}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding Converter={x:Static inf:VisibleWhenSet.Instance}}">
                        <StackPanel Margin="18,16">
                            <TextBlock Text="{Binding Address}" Style="{StaticResource H1}" FontFamily="Consolas" />
                            <TextBlock Text="{Binding FoundName}" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />

                            <Border Style="{StaticResource StatusPill}" Padding="10,7" Margin="0,12,0,0"
                                    Visibility="{Binding ImportMessage, Converter={x:Static inf:VisibleWhenSet.Instance}}">
                                <TextBlock Text="{Binding ImportMessage}" TextWrapping="Wrap" />
                            </Border>
                            <Border CornerRadius="3" Padding="10,7" Margin="0,12,0,0" Background="{DynamicResource StatusDocBg}"
                                    Visibility="{Binding Documented, Converter={x:Static inf:VisibleWhenSet.Instance}}">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StatusDocFg}">
                                    <Run Text="Diese Adresse ist in DokuVault schon dokumentiert" /><Run Text="{Binding Documented.Name, Mode=OneWay, StringFormat=': {0}'}" /><Run Text="." />
                                </TextBlock>
                            </Border>

                            <TextBlock Text="Übernehmen als" Style="{StaticResource Label}" Margin="0,16,0,4" />
                            <ComboBox ItemsSource="{Binding DataContext.TargetTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Target}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" />
                            <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                                <Run Text="Vorschlag:" /> <Run Text="{Binding SuggestionText, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding Reasons}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />

                            <StackPanel Visibility="{Binding Target.Key, Converter={x:Static inf:VisibleWhenSet.Instance}}"
                                        IsEnabled="{Binding CanEdit}">
                                <TextBlock Text="Angaben für DokuVault" Style="{StaticResource H2}" Margin="0,20,0,8" />
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                                                <ContentControl Content="{Binding}" Focusable="False"
                                                                ContentTemplateSelector="{StaticResource FieldEditor}" />
                                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="12" Margin="0,3,0,0"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="IP-Adresse" Style="{StaticResource H2}" Margin="0,12,0,8" />
                                <TextBlock Text="VLAN" Style="{StaticResource Label}" />
                                <ComboBox ItemsSource="{Binding DataContext.NetworkChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Network}" DisplayMemberPath="Label" Margin="0,0,0,10" />
                                <TextBlock Text="Bezeichnung der Adresse" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding IpLabel, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="DokuVault hat kein MAC-Feld – die MAC steht deshalb hier." />
                            </StackPanel>

                            <TextBlock Text="Was das Gerät verrät" Style="{StaticResource H2}" Margin="0,20,0,8" />
                            <TextBox Text="{Binding Findings, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="{DynamicResource Subtle}" Padding="10,8" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Standort" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Sites}" SelectedItem="{Binding DefaultSite}" DisplayMemberPath="Label" Width="220"
                              ToolTip="Für alle Geräte, bei denen kein anderer Standort gewählt ist" Margin="0,0,14,0" />
                    <Button Content="{Binding ImportButtonText}" Style="{StaticResource Primary}" Command="{Binding ImportCommand}" MinWidth="240" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource Muted}" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
