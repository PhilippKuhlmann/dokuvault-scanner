<!-- DokuVault light: resources/css/app.css - cerulean, chathams-blue, Tailwind gray. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#1F73D6" />
    <SolidColorBrush x:Key="AccentHover" Color="#1A5CAD" />
    <SolidColorBrush x:Key="AccentText" Color="#1F73D6" />
    <SolidColorBrush x:Key="AccentLight" Color="#EEF7FF" />
    <SolidColorBrush x:Key="AccentBorder" Color="#BCE0FF" />
    <SolidColorBrush x:Key="PrimaryDisabled" Color="#9EC2E7" />
    <SolidColorBrush x:Key="Heading" Color="#1F3D6E" />

    <SolidColorBrush x:Key="Page" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Subtle" Color="#F9FAFB" />
    <SolidColorBrush x:Key="Line" Color="#E5E7EB" />
    <SolidColorBrush x:Key="LineSoft" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Text" Color="#111827" />
    <SolidColorBrush x:Key="Muted" Color="#6B7280" />
    <SolidColorBrush x:Key="Placeholder" Color="#9CA3AF" />

    <SolidColorBrush x:Key="Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ButtonBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHover" Color="#F3F4F6" />
    <SolidColorBrush x:Key="Popup" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ItemHover" Color="#EEF7FF" />
    <SolidColorBrush x:Key="Selection" Color="#BCE0FF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C7CBD1" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ToolTipBg" Color="#1F2937" />
    <SolidColorBrush x:Key="ToolTipFg" Color="#F9FAFB" />

    <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerLight" Color="#FEF2F2" />
    <SolidColorBrush x:Key="Warn" Color="#92400E" />
    <SolidColorBrush x:Key="WarnLight" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarnBorder" Color="#FDE68A" />

    <!-- DHCP range: slate, as in the IP plan of the web app -->
    <SolidColorBrush x:Key="DhcpRow" Color="#F1F5F9" />
    <SolidColorBrush x:Key="DhcpBar" Color="#94A3B8" />
    <SolidColorBrush x:Key="DhcpPillBg" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DhcpPillFg" Color="#334155" />

    <!-- Status pills in the list -->
    <SolidColorBrush x:Key="StatusNewBg" Color="#EEF7FF" />
    <SolidColorBrush x:Key="StatusNewFg" Color="#1A5CAD" />
    <SolidColorBrush x:Key="StatusDocBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="StatusDocFg" Color="#4B5563" />
    <SolidColorBrush x:Key="StatusDoneBg" Color="#ECFDF5" />
    <SolidColorBrush x:Key="StatusDoneFg" Color="#047857" />
    <SolidColorBrush x:Key="StatusFailBg" Color="#FEF2F2" />
    <SolidColorBrush x:Key="StatusFailFg" Color="#B91C1C" />
    <SolidColorBrush x:Key="StatusRunBg" Color="#FFFBEB" />
    <SolidColorBrush x:Key="StatusRunFg" Color="#92400E" />

    <BitmapImage x:Key="Logo" UriSource="pack://application:,,,/DokuVaultScanner;component/Assets/logo.png" />
</ResourceDictionary>
